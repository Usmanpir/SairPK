// Pakistan Travel & Tourism Platform — core schema
// This covers the foundation + the hotel search -> booking -> payment flow.
// Additional modules (tours, activities, transport, guides, blog, CMS, coupons,
// commissions, notifications) follow the same modeling pattern and can be
// added incrementally — see README for the extension plan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth / Users / Roles ----------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  HOTEL_MANAGER
  TOUR_OPERATOR
  TOUR_GUIDE
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  passwordHash  String?
  image         String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  hotels       Hotel[]        @relation("HotelManager")
  bookings     Booking[]
  reviews      Review[]
  wishlist     Wishlist[]
  passwordResets PasswordResetToken[]
  auditLogs    AuditLog[]     @relation("AuditActor")

  @@index([role])
}

// NextAuth adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Destinations ----------

model Destination {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  region      String // e.g. "Northern Pakistan", "Punjab", "Sindh"
  province    String
  description String  @db.Text
  coverImage  String?
  latitude    Float?
  longitude   Float?
  bestTimeToVisit String?
  seoTitle    String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotels Hotel[]
  images DestinationImage[]

  @@index([region])
}

model DestinationImage {
  id            String      @id @default(cuid())
  destinationId String
  url           String
  alt           String?
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

// ---------- Hotels ----------

enum HotelStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model Hotel {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  description   String      @db.Text
  destinationId String
  address       String
  latitude      Float?
  longitude     Float?
  starRating    Int         @default(3) // 1-5
  status        HotelStatus @default(PENDING)
  checkInTime   String      @default("14:00")
  checkOutTime  String      @default("12:00")
  cancellationPolicy String  @db.Text
  contactPhone  String?
  contactEmail  String?

  managerId String?
  manager   User?   @relation("HotelManager", fields: [managerId], references: [id])

  destination Destination @relation(fields: [destinationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     HotelImage[]
  amenities  HotelAmenity[]
  rooms      Room[]
  reviews    Review[]
  wishlist   Wishlist[]

  @@index([destinationId])
  @@index([status])
}

model HotelImage {
  id      String @id @default(cuid())
  hotelId String
  url     String
  alt     String?
  isCover Boolean @default(false)
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model HotelAmenity {
  id      String @id @default(cuid())
  hotelId String
  name    String // "Free WiFi", "Pool", "Parking", etc.
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

// ---------- Rooms ----------

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  TRIPLE
  FAMILY
  DELUXE
  SUITE
  EXECUTIVE
}

model Room {
  id            String   @id @default(cuid())
  hotelId       String
  name          String
  type          RoomType
  description   String   @db.Text
  maxAdults     Int      @default(2)
  maxChildren   Int      @default(0)
  bedType       String
  numBeds       Int      @default(1)
  sizeSqm       Int?

  basePrice     Decimal  @db.Decimal(10, 2) // PKR, per night
  weekendPrice  Decimal? @db.Decimal(10, 2)
  discountPct   Decimal  @default(0) @db.Decimal(5, 2)
  taxPct        Decimal  @default(0) @db.Decimal(5, 2)

  totalUnits    Int      @default(1) // how many physical rooms of this type exist
  cancellationPolicy String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel        Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  images       RoomImage[]
  amenities    RoomAmenity[]
  availability RoomAvailability[]
  bookingItems BookingItem[]

  @@index([hotelId])
  @@index([type])
}

model RoomImage {
  id     String @id @default(cuid())
  roomId String
  url    String
  alt    String?
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model RoomAmenity {
  id     String @id @default(cuid())
  roomId String
  name   String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

// One row per room per calendar date = the source of truth for availability
// and pricing overrides (seasonal pricing). This is what booking-consistency
// transactions lock against to prevent double-booking.
model RoomAvailability {
  id            String   @id @default(cuid())
  roomId        String
  date          DateTime @db.Date
  unitsAvailable Int     // units left for this room type on this date
  priceOverride Decimal? @db.Decimal(10, 2) // seasonal/custom price, else basePrice applies
  isBlocked     Boolean  @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([date])
}

// ---------- Reviews / Wishlist ----------

model Review {
  id        String   @id @default(cuid())
  userId    String
  hotelId   String?
  rating    Int // 1-5
  title     String?
  comment   String   @db.Text
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model Wishlist {
  id      String @id @default(cuid())
  userId  String
  hotelId String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
}

// ---------- Booking ----------

enum BookingStatus {
  PENDING // inventory soft-reserved, awaiting payment
  PAYMENT_PENDING
  CONFIRMED
  PAID
  CANCELLED
  COMPLETED
  REFUNDED
  EXPIRED // reservation timed out unpaid
}

enum BookingType {
  HOTEL
  TOUR
  ACTIVITY
  TRANSPORT
  GUIDE
  PACKAGE
}

model Booking {
  id            String        @id @default(cuid())
  reference     String        @unique // e.g. PK-TRV-2026-000123
  userId        String
  type          BookingType   @default(HOTEL)
  status        BookingStatus @default(PENDING)

  subtotal      Decimal @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @db.Decimal(10, 2)
  taxTotal      Decimal @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal @db.Decimal(10, 2)
  currency      String  @default("PKR")

  guestName     String
  guestEmail    String
  guestPhone    String

  // Unpaid PENDING bookings must be honored until this timestamp, after which
  // a cleanup job may release the held inventory back to availability.
  reservationExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  items   BookingItem[]
  payment Payment?
  invoice Invoice?

  @@index([userId])
  @@index([status])
}

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  roomId    String?

  checkIn   DateTime @db.Date
  checkOut  DateTime @db.Date
  adults    Int      @default(2)
  children  Int      @default(0)
  nights    Int
  unitPrice Decimal  @db.Decimal(10, 2) // price per night used at booking time
  lineTotal Decimal  @db.Decimal(10, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room?   @relation(fields: [roomId], references: [id])

  @@index([bookingId])
  @@index([roomId])
}

// ---------- Payments / Invoices ----------

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  JAZZCASH
  EASYPAISA
  PAYFAST
  STRIPE
  PAYPAL
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("PKR")
  method        PaymentMethod
  status        PaymentStatus @default(INITIATED)
  providerTxnId String? // transaction id returned by the payment gateway
  providerRaw   Json? // raw gateway response, for audit/debugging
  refundStatus  String?
  refundedAmount Decimal      @default(0) @db.Decimal(10, 2)
  notes         String?       @db.Text // internal notes from the management dashboard

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  invoiceNo   String   @unique
  pdfUrl      String?
  issuedAt    DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// ---------- Management audit trail ----------

// One row per change made from the management dashboard, so admins can see
// who changed an account, booking or payment and when.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "user.create", "booking.status", "payment.update"
  entityType String // "User" | "Booking" | "Payment" | "Hotel"
  entityId   String
  summary    String
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
