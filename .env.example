# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pakistan_travel?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (SMTP) — used for booking confirmations, verification, password reset ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Sair Pakistan <no-reply@sairpakistan.com>"

# --- Cloud storage (hotel/tour/user images, receipts, documents) ---
# Provider-agnostic: set STORAGE_PROVIDER to "s3" | "cloudinary" | "local" and
# fill in the matching credentials below.
STORAGE_PROVIDER="local"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION=""

# --- Payments ---
# PAYMENT_PROVIDER selects the gateway implementation in src/lib/payments.
# "mock" (default, no credentials needed) works out of the box for demos.
PAYMENT_PROVIDER="mock"
PAYMENT_API_KEY=""
PAYFAST_MERCHANT_ID=""
PAYFAST_SECURED_KEY=""
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# --- Maps ---
MAP_API_KEY=""

# --- SMS / WhatsApp notifications ---
SMS_API_KEY=""
WHATSAPP_API_KEY=""

# Never commit a real .env file — this file is a template only.
